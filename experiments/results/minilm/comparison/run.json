{
  "encoder": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "features": [
    "p",
    "h",
    "abs(p-h)",
    "p*h"
  ],
  "shape": [
    9696,
    1536
  ],
  "folds": 5,
  "seed": 42,
  "split": "StratifiedKFold(shuffle=True), por fila",
  "ensemble_uniform": [
    "random_forest",
    "xgboost",
    "lightgbm",
    "catboost",
    "mlp"
  ],
  "threads": 8,
  "device": "cpu",
  "python": "3.14.7",
  "versions": {
    "numpy": "2.5.5",
    "pandas": "3.1.1",
    "scipy": "1.18.1",
    "scikit-learn": "1.9.1",
    "xgboost": "3.4.1",
    "lightgbm": "4.7.0",
    "catboost": "1.2.10"
  },
  "params": {
    "decision_tree": {
      "max_depth": 20,
      "min_samples_leaf": 5
    },
    "knn": {
      "metric": "cosine",
      "n_neighbors": 50,
      "weights": "distance"
    },
    "mlp": {
      "alpha": 0.0001,
      "batch_size": 256,
      "early_stopping": true,
      "hidden_layer_sizes": [
        512
      ],
      "max_iter": 50,
      "n_iter_no_change": 5,
      "validation_fraction": 0.1
    },
    "xgboost": {
      "colsample_bytree": 0.8,
      "learning_rate": 0.1,
      "max_depth": 6,
      "n_estimators": 300,
      "subsample": 0.8,
      "tree_method": "hist"
    },
    "catboost": {
      "allow_writing_files": false,
      "depth": 6,
      "iterations": 300,
      "learning_rate": 0.1,
      "loss_function": "MultiClass",
      "verbose": false
    },
    "lightgbm": {
      "colsample_bytree": 0.8,
      "learning_rate": 0.05,
      "n_estimators": 300,
      "num_leaves": 31,
      "verbose": -1
    },
    "random_forest": {
      "criterion": "gini",
      "max_depth": 50,
      "max_features": "sqrt",
      "min_samples_leaf": 5,
      "min_samples_split": 5,
      "n_estimators": 1000
    }
  }
}